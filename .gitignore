## .NET / Visual Studio standard gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio cache/options
.vs/
*.VC.db
*.VC.VC.opendb

# Rider
.idea/

# VS Code
.vscode/

# Claude Code
.serena/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# dotnet
project.lock.json
project.fragment.lock.json
artifacts/
.dotnet/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# EphemeralMongo / local test data
*.mongod.lock

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
*.env
.env.local
